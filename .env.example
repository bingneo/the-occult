# =============================================================================
# SciBlock-occult Environment Variables
# =============================================================================
# Copy to .env and fill in your values.
# docker compose up --env-file .env

# ---- Database (PostgreSQL) ----
DB_USER=occult
DB_PASSWORD=change-me
DB_NAME=occult
DATABASE_URL=postgresql://occult:change-me@postgres:5432/occult

# ---- App ----
PORT=3000
SESSION_SECRET=change-me-to-random-string
APP_URL=http://localhost
NODE_ENV=production
LOG_LEVEL=info

# ---- Storage (S3 / SeaweedFS) ----
STORAGE_BACKEND=s3
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:28333
S3_BUCKET=occult
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
PRIVATE_OBJECT_DIR=occult-uploads
PUBLIC_OBJECT_SEARCH_PATHS=occult-public

# ---- AI (optional, DeepSeek / QWEN) ----
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# QWEN_API_KEY=sk-xxxxxxxx

# ---- Email (optional, Resend) ----
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFICATION_FROM_EMAIL=The Occult <noreply@yourdomain.com>

# ---- Port mappings (host) ----
APP_PORT=22336
WEB_PORT=22334
DB_PORT=25436
S3_PORT=28333

# =============================================================================
# SciBlock-occult Production Environment (Aliyun)
# =============================================================================
# 复制此文件为 .env.aliyun 并填写实际值
#
# 部署命令:
#   docker compose -f docker-compose.aliyun.yml --env-file .env.aliyun up -d
#
# ⚠️ 安全警告: 此文件包含密钥和密码，切勿提交到 Git！
# =============================================================================

# ---- Database (PostgreSQL) ----
DB_USER=occult
DB_PASSWORD=CHANGE_ME
DB_NAME=occult
DATABASE_URL=postgresql://occult:CHANGE_ME@postgres:5432/occult

# ---- App ----
PORT=3000
SESSION_SECRET=CHANGE_ME
APP_URL=https://occult.isciblock.com
NODE_ENV=production
LOG_LEVEL=info

# ---- Storage (S3 / SeaweedFS) ----
STORAGE_BACKEND=s3
S3_ENDPOINT=http://seaweedfs:8333
# 生产环境 S3 公网访问地址（浏览器直接访问）
# 方案 A (子路径代理): https://occult.isciblock.com/s3
# 方案 B (独立子域名): https://s3.occult.isciblock.com
S3_PUBLIC_ENDPOINT=https://occult.isciblock.com/s3
S3_BUCKET=occult
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
PRIVATE_OBJECT_DIR=occult-uploads
PUBLIC_OBJECT_SEARCH_PATHS=occult-public

# ---- AI (DeepSeek) ----
# 必填: 用于 Occy AI 助手
DEEPSEEK_API_KEY=sk-CHANGE_ME

# ---- AI (备用: QWEN) ----
# QWEN_API_KEY=sk-CHANGE_ME

# ---- Email (optional, Resend) ----
# RESEND_API_KEY=re_CHANGE_ME
# NOTIFICATION_FROM_EMAIL=The Occult <noreply@isciblock.com>

# ---- Port mappings (host -> container) ----
# 仅 frontend (WEB_PORT) 和 S3 (S3_PORT) 暴露给堡垒机
# API 和 DB 不映射到宿主机，只走 Docker 内网
WEB_PORT=22334
S3_PORT=28333
